# ── Live mode only. Replay mode (npm run dev) needs none of this. ──

# Server-side only. NEVER prefix an API key with VITE_ (that bundles it into the
# browser). Read exclusively inside /api functions via process.env.
OPENAI_API_KEY=sk-your-key-here
# Fast, non-reasoning default — no reasoning latency. Set a gpt-5* id later and the
# handlers automatically switch to the reasoning params (max_completion_tokens +
# reasoning_effort); a classic model like this one uses temperature + max_tokens.
OPENAI_MODEL=gpt-4o-mini

# Hard monthly USD ceiling enforced in-app (the friendly cutover to replay).
# The real backstop is a usage limit set in the OpenAI dashboard.
MONTHLY_USD_CAP=5

# Durable rate-limit + spend counter (optional). If unset, the app falls back to
# an in-memory limiter (resets on cold start) — fine for local/dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client flag (safe to expose). Set true to force replay even in a live deploy.
VITE_FORCE_REPLAY=false
