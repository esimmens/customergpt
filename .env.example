# ── Live mode only. Replay mode (npm run dev) needs none of this. ──

# Server-side only. NEVER prefix an API key with VITE_ (that bundles it into the
# browser). Read exclusively inside /api functions via process.env.
OPENAI_API_KEY=sk-your-key-here
# Reasoning models only (gpt-5 line). Swap in a newer id to upgrade.
OPENAI_MODEL=gpt-5.6-luna

# Spending is capped by the hard usage limit set in the OpenAI dashboard, not here.

# Durable rate limiting (optional). If unset, the app falls back to an in-memory
# limiter (resets on cold start) — fine for local/dev.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Client flag (safe to expose). Set true to force replay even in a live deploy.
VITE_FORCE_REPLAY=false
